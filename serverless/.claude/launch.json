{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "babyfoon-web (root, node server.js)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        ".."
      ],
      "port": 3000
    },
    {
      "name": "arcana (vite dev server)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "arcana"
      ],
      "port": 5173
    },
    {
      "name": "arcana (gebouwde bundel, vite preview)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "preview",
        "--prefix",
        "arcana",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    },
    {
      "name": "deelbuur (next dev)",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "../../Deelbuur-repo",
        "dev",
        "--port",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "verkoophub",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start",
        "--prefix",
        "../../verkoophub"
      ],
      "port": 4321
    }
  ]
}