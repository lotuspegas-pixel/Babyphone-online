{
  "name": "arcana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-seo-files.mjs && tsc -b && vite build && node scripts/check-domains.mjs dist && node scripts/controleer-jsonld.mjs && node scripts/meet-bundel.mjs",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "sample": "vitest run --dir src/dev --exclude '' -t 'voorbeeldrapport'",
    "overlap": "vitest run --dir src/dev --exclude '' -t 'tekstoverlap' --reporter=verbose",
    "preview": "vite preview",
    "check:domains": "node scripts/check-domains.mjs dist"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
